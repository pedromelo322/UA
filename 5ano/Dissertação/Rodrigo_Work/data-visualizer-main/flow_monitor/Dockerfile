# flow_monitor: eBPF/TC flow monitor that publishes flow snapshots over ZeroMQ.
#
# The image builds the program from source on top of Ubuntu 24.04, generating
# vmlinux.h / the BPF object / the skeleton at build time via bpftool (CO-RE
# makes the resulting binary portable to other kernel versions at run time).
#
# Build:
#   docker build -t flow_monitor .
#
# Run (needs host networking to see a real NIC, plus the caps eBPF/TC require):
#   docker run --rm -it \
#     --network host \
#     --cap-add NET_ADMIN --cap-add BPF --cap-add SYS_ADMIN --cap-add SYS_RESOURCE \
#     -v /sys/kernel/btf:/sys/kernel/btf:ro \
#     -p 5556:5556 \
#     flow_monitor -i eth0

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        clang \
        llvm \
        make \
        pkg-config \
        linux-tools-common \
        linux-tools-generic \
        libbpf-dev \
        libelf-dev \
        zlib1g-dev \
        libzmq3-dev \
        libjson-c-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY Makefile flow_monitor.c flow_monitor.bpf.c ./

# vmlinux.h, flow_monitor.bpf.o and flow_monitor.skel.h are generated by the
# Makefile from /sys/kernel/btf/vmlinux, which is exposed by the kernel the
# build runs on.
RUN make

ENTRYPOINT ["./flow_monitor"]
CMD ["-h"]
